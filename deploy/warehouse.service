[Unit]
Description=FastAPI warehouse controller
After=network.target

[Service]
Type=simple
User=warehouse
WorkingDirectory=/opt/warehouse
EnvironmentFile=/opt/warehouse/.env
ExecStart=/opt/warehouse/.venv/bin/python /opt/warehouse/tools/run_server.py
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
