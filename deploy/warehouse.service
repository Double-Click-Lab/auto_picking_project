[Unit]
Description=FastAPI warehouse controller
After=network.target

[Service]
Type=simple
User=warehouse
WorkingDirectory=/opt/warehouse
EnvironmentFile=/opt/warehouse/.env
ExecStart=/opt/warehouse/.venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 8000 --workers 1
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
