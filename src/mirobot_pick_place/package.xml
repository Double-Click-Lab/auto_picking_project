<?xml version="1.0"?>
<package format="3">
  <name>mirobot_pick_place</name>
  <version>0.0.1</version>
  <description>WLKATA Mirobot Pick and Place ROS2 package</description>
  <maintainer email="leehanbin@todo.todo">leehanbin</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>std_srvs</exec_depend>
  <exec_depend>action_msgs</exec_depend>
  <exec_depend>python3-serial</exec_depend>
  <test_depend>python3-pytest</test_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>mirobot_pick_place_interfaces</exec_depend>

  <exec_depend>launch</exec_depend>

  <exec_depend>launch_ros</exec_depend>

  <export>
    <build_type>ament_python</build_type>
